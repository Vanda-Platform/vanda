{
    "name": "vanda/core",
    "description": "Vanda core: screens, typed UI schema, state snapshots, actions and reactions for Laravel back-offices.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin",
        "admin-panel",
        "back-office",
        "orchid",
        "inertia",
        "react",
        "screens"
    ],
    "homepage": "https://github.com/Vanda-Platform/vanda",
    "support": {
        "issues": "https://github.com/Vanda-Platform/vanda/issues",
        "source": "https://github.com/Vanda-Platform/vanda"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Vanda\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vanda\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vanda\\VandaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
