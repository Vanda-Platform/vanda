#!/usr/bin/env bash
# Publishes packages/core as the root of Vanda-Platform/core, the repository Packagist reads for
# vanda/core. Run it from a clean checkout of main after the release commit:
#
#   bin/release-core            # brings main of Vanda-Platform/core up to HEAD
#   bin/release-core v0.2.0     # and tags that version there (tag the monorepo with it too)
#
# The split keeps the history of packages/core only; Packagist picks up the new tag by itself
# once the repository is connected to it.
set -euo pipefail

remote="${VANDA_CORE_REMOTE:-git@github.com:Vanda-Platform/core.git}"
version="${1:-}"

cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain -- packages/core)" ]; then
    echo "packages/core has uncommitted changes; commit them first." >&2
    exit 1
fi
if [ -n "$version" ] && ! [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]]; then
    echo "\"$version\" is not a version tag; write it as v1.2.3 (or v1.2.3-beta.1)." >&2
    exit 1
fi

sha="$(git subtree split --prefix=packages/core HEAD)"
git push "$remote" "$sha:refs/heads/main"
if [ -n "$version" ]; then
    git push "$remote" "$sha:refs/tags/$version"
fi

echo "packages/core at ${sha:0:7} → $remote${version:+ ($version)}"
